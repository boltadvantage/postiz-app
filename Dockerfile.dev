# Bolt Advantage: layered build. Dependencies (~3.3 GB) get their own layer that
# only changes when package.json / pnpm-lock.yaml change, so a code-only update
# re-ships just the built app (~800 MB) and the NAS reuses everything else.
# Build tools stay in the build stages and never reach the runtime image.

# ---- runtime base: what the running container needs, rarely changes ----
FROM node:22.23.4-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

# the container runs `pnpm dlx prisma@6.5.0 db push` on every start; cache it here
RUN cd /tmp && pnpm dlx prisma@6.5.0 --version && rm -rf /tmp/*

# ---- deps: install from the manifests only ----
FROM node:22.23.4-bookworm-slim AS deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
&& rm -rf /var/lib/apt/lists/*
RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/backend/package.json apps/backend/
COPY apps/commands/package.json apps/commands/
COPY apps/extension/package.json apps/extension/
COPY apps/frontend/package.json apps/frontend/
COPY apps/orchestrator/package.json apps/orchestrator/
COPY apps/sdk/package.json apps/sdk/
# apps/frontend's postinstall (only fetches Google Tag Manager when NEXT_PUBLIC_GTM_ID is set)
COPY apps/frontend/scripts/fetch-gtm.mjs apps/frontend/scripts/

# The root postinstall runs `prisma generate`, which needs the schema. The real
# schema changes often, so give it a fixed placeholder here (keeping this layer
# stable); the build stage regenerates the client from the real one.
RUN mkdir -p libraries/nestjs-libraries/src/database/prisma \
 && printf 'generator client {\n  provider = "prisma-client-js"\n}\ndatasource db {\n  provider = "postgresql"\n  url = env("DATABASE_URL")\n}\nmodel Placeholder {\n  id Int @id\n}\n' \
      > libraries/nestjs-libraries/src/database/prisma/schema.prisma \
 && pnpm install --frozen-lockfile \
 && rm -rf libraries

# ---- build: source + compile ----
FROM deps AS build
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
COPY . /app
RUN pnpm run prisma-generate
# The frontend shows NEXT_PUBLIC_VERSION under the channel list. CI passes
# "bolt-<commit sha>"; turn it into "v1.47.0 · bolt fc65cb1 · 2026-11-01".
RUN base="$(tr -d '\n' < version.txt)" \
 && sha="$(printf %s "${NEXT_PUBLIC_VERSION#bolt-}" | cut -c1-7)" \
 && export NEXT_PUBLIC_VERSION="$base · bolt ${sha:-local} · $(date -u +%Y-%m-%d)" \
 && printf '%s\n' "$NEXT_PUBLIC_VERSION" > /app/VERSION \
 && NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

# everything except node_modules, plus the generated Prisma client
RUN mkdir /out \
 && tar -C /app \
      --exclude=./node_modules \
      --exclude=./apps/frontend/.next/cache \
      -cf - . | tar -C /out -xf - \
 && mkdir -p /out/node_modules \
 && cp -a /app/node_modules/.prisma /out/node_modules/.prisma

# ---- final image ----
FROM runtime
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
COPY var/docker/nginx.conf /etc/nginx/nginx.conf
WORKDIR /app
COPY --from=deps /app/node_modules /app/node_modules
COPY --from=build /out /app

CMD ["sh", "-c", "nginx && pnpm run pm2"]
